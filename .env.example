# Copy to .env. Shell variables take precedence.
ERAG_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ERAG_BACKEND=ark
ERAG_LLM_API_KEY=
# Your enabled Ark model ID/endpoint (ep-...), or qwen3-instruct for Xinference.
ERAG_LLM_MODEL=doubao-seed-1-6-flash-250615
# Empty means the same model handles both agent roles.
ERAG_RETRIEVAL_MODEL=
ERAG_LLM_EXTRA_BODY={}
# Use Ark's compatible embedding endpoint when available, otherwise Xinference.
ERAG_EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
ERAG_EMBEDDING_API_KEY=local
ERAG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# openai or ark_multimodal
ERAG_EMBEDDING_PROTOCOL=openai
ERAG_EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve relevant teaching materials that answer the question
ERAG_EMBEDDING_REVISION=2025-06
ERAG_RERANK_ENABLED=true
ERAG_RERANK_BASE_URL=http://127.0.0.1:9997/v1
ERAG_RERANK_API_KEY=local
ERAG_RERANK_MODEL=Qwen3-Reranker-0.6B
ERAG_KNOWLEDGE_BASE_ROOT=./data/knowledge_bases
ERAG_SUB_QUERY_TOP_K=5
ERAG_PER_QUERY_TOP_K=4
ERAG_FINAL_TOP_K=15
ERAG_SUMMARY_MIN_SCORE=0.2
ERAG_TAG_MIN_SCORE=0.2
ERAG_TCT_ENABLED=true
# Initial retrieval + at most two feedback retrievals.
ERAG_MAX_RETRIEVAL_ROUNDS=3
ERAG_CONTEXT_MAX_CHARS=24000
ERAG_HISTORY_TURNS=5
ERAG_UI_HOST=127.0.0.1
ERAG_UI_PORT=7860
ERAG_ENABLE_THINKING=false
