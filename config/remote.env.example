# Remote deployment template. No SSH password belongs in this file.
ERAG_BACKEND=xinference
ERAG_LLM_BASE_URL=http://127.0.0.1:9997/v1
ERAG_LLM_API_KEY=local
ERAG_LLM_MODEL=qwen3-instruct
ERAG_EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
ERAG_EMBEDDING_API_KEY=local
ERAG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
ERAG_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
ERAG_RERANK_BASE_URL=http://127.0.0.1:9997/v1
ERAG_RERANK_API_KEY=local
ERAG_RERANK_MODEL=Qwen3-Reranker-0.6B
ERAG_RERANK_ENABLED=true
ERAG_ENRICH_ENABLED=false
# Optional: the measured smoke dialogue gained no answer quality from TCT and made extra calls.
ERAG_TCT_ENABLED=false
ERAG_MAX_RETRIEVAL_ROUNDS=3
ERAG_ENABLE_THINKING=false
ERAG_KNOWLEDGE_BASE_ROOT=./data/knowledge_bases
ERAG_UI_HOST=127.0.0.1
ERAG_UI_PORT=7860

# Raw recall retains details without requiring LLM summaries. Rebuild legacy indexes for v4.
ERAG_RETRIEVAL_MODE=raw
ERAG_CONTEXTUAL_RANKING=true
ERAG_TCT_MODE=focused
ERAG_PER_QUERY_TOP_K=50
ERAG_FINAL_TOP_K=5
ERAG_CONTEXT_MAX_CHARS=16000
